# Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=legal-mx
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Vectorstore
VECTORSTORE_PATH=./legal_db
VECTORSTORE_COLLECTION=jurislex

# API Server
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# Ingestion
BATCH_SIZE=500
CHUNK_SIZE=800
CHUNK_OVERLAP=150
